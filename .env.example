# 配置模板：复制本文件为 .env，填入自己的真实值。
# .env 已被 .gitignore 排除，不会上传 GitHub；本模板可以公开。

# DeepSeek 开放平台密钥
DEEPSEEK_API_KEY=你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MySQL 数据库连接
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_HOST=localhost
DB_NAME=job_db

# 岗位巡检 HTML 所在的本地目录（可选，不填则巡检脚本跳过本次同步）
JOB_CENTER_DIR=
